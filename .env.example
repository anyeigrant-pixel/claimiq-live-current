# AWS scaffolding only: do not commit real credentials.
AWS_REGION=us-east-1
CLAIMIQ_S3_BUCKET=replace-with-your-bucket
CLAIMIQ_SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/ClaimIQSageMakerRole
CLAIMIQ_MODEL_PACKAGE_GROUP=claimiq-severity-models
CLAIMIQ_ENDPOINT_NAME=claimiq-severity-endpoint
CLAIMIQ_LOG_LEVEL=INFO
# Optional absolute path to a pre-downloaded SentenceTransformer model. When absent, ClaimIQ uses offline dense TF-IDF/SVD embeddings.
CLAIMIQ_SENTENCE_TRANSFORMER_PATH=
